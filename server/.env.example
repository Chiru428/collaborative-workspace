# MongoDB Connection String (from MongoDB Atlas)
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collaborative-workspace?retryWrites=true&w=majority"

# Redis URL (from Upstash)
REDIS_URL="rediss://default:<password>@<endpoint>.upstash.io:6379"

# JWT Secret (for signing authentication tokens)
JWT_SECRET="generate-a-long-random-string-at-least-16-chars"

PORT=5000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional: public base URL of this API, used when building upload URLs (defaults to the request host)
# PUBLIC_URL="https://api.example.com"

# Optional Redis cache (disabled unless REDIS_ENABLED=true and REDIS_URL is set)
# REDIS_ENABLED=true

# Token lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# Optional: where uploaded images are stored (defaults to ./uploads)
# UPLOAD_DIR=./uploads
